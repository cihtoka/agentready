# LLM 제공자: mock | openai | anthropic | replay
LLM_PROVIDER=mock
# 모델명 (openai 호환 기본값 gpt-4o-mini, anthropic 기본값 claude-sonnet-5-5)
LLM_MODEL=
# OpenAI 호환 API 주소 (DeepSeek, Ollama, 사내 게이트웨이 등은 여기만 변경)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 1이면 실제 LLM 응답을 data/recordings/ 에 녹화 (내부망 시연용 replay 모드에서 재생)
RECORD=0
# replay 모드에서 녹화본에 없는 요청이 오면 mock 으로 대체하려면 mock
REPLAY_FALLBACK=
MAX_ITERATIONS=4
MAX_ACTIONS_PER_ITER=3
